<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.JobMatch_Frontend" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Core colors -->
        <item name="colorPrimary">@color/primary_blue</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/primary_blue_dark</item>
        <item name="colorOnPrimaryContainer">@color/primary_blue_light</item>

        <item name="colorSecondary">@color/secondary_blue</item>
        <item name="colorOnSecondary">@color/white</item>

        <item name="colorTertiary">@color/tertiary_green</item>
        <item name="colorOnTertiary">@color/white</item>

        <item name="android:statusBarColor">@color/primary_blue_dark</item>

        <!-- Component Styles -->
        <item name="materialButtonStyle">@style/Widget.JobMatch.Button</item>
        <item name="textInputStyle">@style/Widget.JobMatch.TextInputLayout</item>
    </style>
</resources>