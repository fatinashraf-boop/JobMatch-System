<?xml version="1.0" encoding="utf-8"?>

<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="#D9EDF2"
    android:layout_marginBottom="10dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="1dp"
    app:strokeColor="#E5E5E5"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">


            <TextView
                android:id="@+id/tvDocumentType"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Certificate"
                android:textColor="#0083B0"
                android:textSize="13sp"
                android:textStyle="bold" />


            <TextView
                android:id="@+id/tvDocumentStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="#E8F7F1"
                android:paddingHorizontal="8dp"
                android:paddingVertical="4dp"
                android:text="Processed"
                android:textColor="#16865C"
                android:textSize="11sp"
                android:textStyle="bold" />

        </LinearLayout>


        <TextView
            android:id="@+id/tvDocumentName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:maxLines="2"
            android:text="Degree_Certificate.pdf"
            android:textColor="#202124"
            android:textSize="15sp"
            android:textStyle="bold" />


        <TextView
            android:id="@+id/tvOcrConfidence"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:text="OCR Confidence: 94%"
            android:textColor="#555555"
            android:textSize="13sp" />


        <TextView
            android:id="@+id/tvOcrIssuer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Issuer: Not detected"
            android:textColor="#777777"
            android:textSize="12sp" />


        <TextView
            android:id="@+id/tvOcrPreview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:ellipsize="end"
            android:maxLines="3"
            android:text="OCR extracted text..."
            android:textColor="#777777"
            android:textSize="12sp" />


        <Button
            android:id="@+id/btnViewOcr"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginTop="8dp"
            android:text="View OCR"
            android:textSize="11sp" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>