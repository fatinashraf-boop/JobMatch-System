<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="#FFFFFF">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="#00A7C4" android:padding="18dp">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal"><TextView android:id="@+id/btnBack" android:layout_width="42dp" android:layout_height="42dp" android:text="‹" android:textSize="34sp" android:textColor="#FFFFFF" android:gravity="center"/><TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="Browse Jobs &amp; Candidates" android:textSize="23sp" android:textStyle="bold" android:textColor="#FFFFFF"/></LinearLayout>
<EditText android:id="@+id/etSearch" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="14dp" android:background="@drawable/bg_dashboard_search" android:drawableStart="@android:drawable/ic_menu_search" android:drawablePadding="10dp" android:hint="Search job title..." android:inputType="text" android:imeOptions="actionSearch" android:singleLine="true" android:paddingStart="16dp" android:paddingEnd="16dp" android:textColor="#222222" android:textColorHint="#999999" android:textSize="14sp"/></LinearLayout>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="#FFFFFF" android:padding="16dp"><RadioGroup android:id="@+id/rgSearchType" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal"><RadioButton android:id="@+id/rbJobs" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="My Jobs" android:checked="true"/><RadioButton android:id="@+id/rbCandidates" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="Candidates"/></RadioGroup><com.google.android.material.button.MaterialButton android:id="@+id/btnSearch" android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginTop="10dp" android:text="Search Jobs" android:textAllCaps="false" android:textColor="#FFFFFF" app:backgroundTint="#0083B0" app:cornerRadius="14dp"/></LinearLayout>
<LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="vertical" android:padding="16dp"><TextView android:id="@+id/tvSearchStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#555555" android:textStyle="bold" android:paddingBottom="12dp"/><ProgressBar android:id="@+id/progressBar" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center" android:visibility="gone"/><ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"><LinearLayout android:id="@+id/searchResults" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"/></ScrollView></LinearLayout>
    <!-- Bottom navigation: same icon-over-label structure as BrowseJobsActivity -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="72dp"
        android:orientation="horizontal" android:background="#FFFFFF" android:elevation="12dp"
        android:gravity="center" android:paddingTop="7dp" android:paddingBottom="6dp" android:weightSum="4">
        <LinearLayout android:id="@+id/navHome" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="match_parent" android:gravity="center" android:orientation="vertical"
            android:clickable="true" android:focusable="true">
            <ImageView android:layout_width="24dp" android:layout_height="24dp"
                android:contentDescription="Home" android:src="@drawable/ic_home" app:tint="#888888" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="3dp" android:text="Home" android:textColor="#888888"
                android:textSize="11sp" />
        </LinearLayout>
        <LinearLayout android:id="@+id/navJobs" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="match_parent" android:gravity="center" android:orientation="vertical"
            android:clickable="true" android:focusable="true">
            <ImageView android:layout_width="24dp" android:layout_height="24dp"
                android:contentDescription="Jobs" android:src="@drawable/ic_search" app:tint="#0083B0" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="3dp" android:text="Jobs" android:textColor="#0083B0"
                android:textSize="11sp" />
        </LinearLayout>
        <LinearLayout android:id="@+id/navApplicants" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="match_parent" android:gravity="center" android:orientation="vertical"
            android:clickable="true" android:focusable="true">
            <ImageView android:layout_width="24dp" android:layout_height="24dp"
                android:contentDescription="Applicants" android:src="@drawable/ic_application" app:tint="#888888" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="3dp" android:text="Applicants" android:textColor="#888888"
                android:textSize="11sp" />
        </LinearLayout>
        <LinearLayout android:id="@+id/navAccount" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="match_parent" android:gravity="center" android:orientation="vertical"
            android:clickable="true" android:focusable="true">
            <ImageView android:layout_width="24dp" android:layout_height="24dp"
                android:contentDescription="Account" android:src="@drawable/ic_profile" app:tint="#888888" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="3dp" android:text="Account" android:textColor="#888888"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
