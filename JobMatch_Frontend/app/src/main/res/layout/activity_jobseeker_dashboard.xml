<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:orientation="vertical">

    <!-- SCROLLABLE CONTENT -->

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- ============================== -->
            <!-- HEADER -->
            <!-- ============================== -->

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="#00A7C4"
                app:cardCornerRadius="0dp"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="22dp"
                    android:paddingTop="28dp"
                    android:paddingEnd="22dp"
                    android:paddingBottom="22dp">

                    <!-- USER HEADER -->

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvUserHeadline"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Good Morning"
                                android:textColor="#EAFBFF"
                                android:textSize="14sp" />

                            <TextView
                                android:id="@+id/tvWelcomeUser"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="3dp"
                                android:maxLines="1"
                                android:text="Fatin Hannah"
                                android:textColor="#FFFFFF"
                                android:textSize="24sp"
                                android:textStyle="bold" />

                        </LinearLayout>

                        <!-- PROFILE / ACCOUNT SHORTCUT -->

                        <FrameLayout
                            android:id="@+id/btnCompleteProfile"
                            android:layout_width="46dp"
                            android:layout_height="46dp"
                            android:background="@drawable/bg_profile_circle"
                            android:clickable="true"
                            android:focusable="true">

                            <!-- Fallback when no profile photo exists -->
                            <ImageView
                                android:id="@+id/imgDashboardProfileFallback"
                                android:layout_width="46dp"
                                android:layout_height="46dp"
                                android:layout_gravity="center"
                                android:contentDescription="Default profile picture"
                                android:padding="11dp"
                                android:src="@drawable/ic_profile"
                                app:tint="#0083B0" />

                            <!-- Actual uploaded profile photo -->
                            <ImageView
                                android:id="@+id/imgDashboardProfile"
                                android:layout_width="46dp"
                                android:layout_height="46dp"
                                android:layout_gravity="center"
                                android:contentDescription="Profile picture"
                                android:scaleType="centerCrop"
                                android:visibility="gone" />

                        </FrameLayout>
                    </LinearLayout>


                    <!-- SEARCH -->

                    <TextView
                        android:id="@+id/btnBrowseJobs"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:layout_marginTop="20dp"
                        android:background="@drawable/bg_dashboard_search"
                        android:drawableStart="@android:drawable/ic_menu_search"
                        android:drawablePadding="10dp"
                        android:gravity="center_vertical"
                        android:paddingStart="18dp"
                        android:paddingEnd="18dp"
                        android:text="Search job here..."
                        android:textColor="#8A8A8A"
                        android:textSize="14sp" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>


            <!-- ============================== -->
            <!-- CONTENT -->
            <!-- ============================== -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingTop="18dp"
                android:paddingEnd="16dp"
                android:paddingBottom="24dp">


                <!-- ============================== -->
                <!-- STATISTICS -->
                <!-- ============================== -->

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="110dp"
                    android:orientation="horizontal">

                    <!-- JOBS APPLIED -->

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cardJobsApplied"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        app:cardBackgroundColor="#3DB4D8"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="2dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvJobsApplied"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0"
                                android:textColor="#FFFFFF"
                                android:textSize="28sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="Jobs Applied"
                                android:textColor="#FFFFFF"
                                android:textSize="13sp" />

                        </LinearLayout>

                    </com.google.android.material.card.MaterialCardView>


                    <!-- INTERVIEWS -->

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cardInterviews"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        app:cardBackgroundColor="#26C281"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="2dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvInterviews"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0"
                                android:textColor="#FFFFFF"
                                android:textSize="28sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="Interviews"
                                android:textColor="#FFFFFF"
                                android:textSize="13sp" />

                        </LinearLayout>

                    </com.google.android.material.card.MaterialCardView>

                </LinearLayout>


                <!-- ============================== -->
                <!-- BEST MATCHES HEADER -->
                <!-- ============================== -->

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="26dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Best Matches"
                        android:textColor="#222222"
                        android:textSize="19sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvMoreMatches"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:padding="6dp"
                        android:text="More  ›"
                        android:textColor="#0083B0"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                </LinearLayout>


                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Recommended jobs based on your profile"
                    android:textColor="#888888"
                    android:textSize="13sp" />


                <!-- NO MATCHES -->

                <TextView
                    android:id="@+id/tvNoMatches"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:background="#FFFFFF"
                    android:gravity="center"
                    android:padding="24dp"
                    android:text="No job matches available yet. Complete your profile to improve your recommendations."
                    android:textColor="#777777"
                    android:textSize="14sp"
                    android:visibility="gone" />


                <!-- REAL AI BEST MATCHES -->

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recyclerViewJobs"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:nestedScrollingEnabled="false" />


                <!-- Existing ID retained for Java compatibility -->

                <Button
                    android:id="@+id/btnMyApplications"
                    android:layout_width="1dp"
                    android:layout_height="1dp"
                    android:visibility="gone" />

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

    <!-- ============================== -->
    <!-- BOTTOM NAVIGATION -->
    <!-- ============================== -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:background="#FFFFFF"
        android:elevation="12dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingTop="7dp"
        android:paddingBottom="6dp"
        android:weightSum="4">

        <!-- HOME -->
        <LinearLayout
            android:id="@+id/navHome"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="Home"
                android:src="@drawable/ic_home"
                app:tint="#0083B0" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="Home"
                android:textColor="#0083B0"
                android:textSize="11sp"
                android:textStyle="bold" />

        </LinearLayout>


        <!-- JOBS -->
        <LinearLayout
            android:id="@+id/navJobs"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="Jobs"
                android:src="@drawable/ic_search"
                app:tint="#888888" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="Jobs"
                android:textColor="#777777"
                android:textSize="11sp" />

        </LinearLayout>


        <!-- APPLICATIONS -->
        <LinearLayout
            android:id="@+id/navApplications"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="Applications"
                android:src="@drawable/ic_application"
                app:tint="#888888" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="Applications"
                android:textColor="#777777"
                android:textSize="11sp" />

        </LinearLayout>


        <!-- ACCOUNT -->
        <LinearLayout
            android:id="@+id/navAccount"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="Account"
                android:src="@drawable/ic_profile"
                app:tint="#888888" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="Account"
                android:textColor="#777777"
                android:textSize="11sp" />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>